<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.nanometer</groupId>
        <artifactId>nanometer-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>nanometer-api</artifactId>
    <packaging>jar</packaging>

    <name>Nanometer :: API &amp; Runtime</name>
    <description>Main Facade API, Integration Runtime, and Architecture Tests</description>

    <dependencies>
        <dependency>
            <groupId>io.nanometer</groupId>
            <artifactId>nanometer-model</artifactId>
        </dependency>
        <dependency>
            <groupId>io.nanometer</groupId>
            <artifactId>nanometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.nanometer</groupId>
            <artifactId>nanometer-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>io.nanometer</groupId>
            <artifactId>nanometer-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>io.nanometer</groupId>
            <artifactId>nanometer-visualizer</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>se.deversity.async-test-lib</groupId>
            <artifactId>async-test-lib</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Shaded JAR Plugin (relocating bytebuddy and sqlite for zero classpath conflict) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <!--
                                Shade rewrites the bytecode inside META-INF/versions/N/ entries to
                                the relocated package but cannot rewrite their entry paths, which
                                leaves e.g. META-INF/versions/24/net/bytebuddy/.../AsmAttribute.class
                                declaring nanometer.shaded.bytebuddy...AsmAttribute. Loading such an
                                entry raises NoClassDefFoundError "wrong name".

                                This uber-JAR is deliberately not a multi-release JAR: its manifest
                                carries no Multi-Release attribute, so the JVM already ignores every
                                META-INF/versions/ entry. Dropping them from the relocated artifacts
                                removes dead bytes rather than changing behaviour, and removes the
                                trap that adding Multi-Release later would spring.

                                The filter covers every artifact, not just the relocated ones:
                                org.jspecify also contributes a META-INF/versions/9 module-info and
                                OSGi metadata that an uber-JAR cannot use either. ShadedJarLayoutIT
                                pins the invariant.
                            -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/versions/*/OSGI-INF/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!--
                                org.sqlite is deliberately NOT relocated. sqlite-jdbc is a JNI
                                library: its native binary exports symbols named for the original
                                package, Java_org_sqlite_core_NativeDB_*, and looks its classes up
                                by that name. Renaming the Java side makes the JVM search for
                                symbols that do not exist, so the shaded JAR failed at the first
                                query with NoClassDefFoundError: org/sqlite/core/NativeDB. A
                                native library cannot be relocated by a bytecode rewriter.

                                Byte Buddy is pure Java and stays relocated, which is where the
                                real conflict risk lies: a host application running its own agent
                                would otherwise meet two copies of it.
                            -->
                            <relocations>
                                <relocation>
                                    <pattern>META-INF.versions.24.net.bytebuddy</pattern>
                                    <shadedPattern>META-INF.versions.24.nanometer.shaded.bytebuddy</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.bytebuddy</pattern>
                                    <shadedPattern>nanometer.shaded.bytebuddy</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <!--
                                    Rewrites META-INF/services entries through the relocators. Without
                                    it the SQLite driver's service file still named org.sqlite.JDBC, a
                                    class relocation had already renamed, so DriverManager reported
                                    "No suitable driver found for jdbc:sqlite:" and the embedded store
                                    never worked from the shaded JAR. ShadedJarLayoutIT pins it.
                                -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>nanometer.agent.NanometerAgent</Premain-Class>
                                        <Agent-Class>nanometer.agent.NanometerAgent</Agent-Class>
                                        <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Integration tests run after package, so they can exercise the shaded uber-JAR that
                actually ships. The surefire suite only ever sees the unshaded module classpath,
                which is why a shaded agent that instrumented nothing went unnoticed.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <nanometer.shaded.jar>${project.build.directory}/${project.build.finalName}-all.jar</nanometer.shaded.jar>
                        <nanometer.it.classes>${project.build.testOutputDirectory}</nanometer.it.classes>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
